# ============================================================
# MDK FRONTLINE - ENVIRONMENT CONFIGURATION
# ============================================================

# ------------------------------------------------------------
# LOGGING
# ------------------------------------------------------------
LOG_LEVEL=INFO

# ------------------------------------------------------------
# RATE LIMITING
# ------------------------------------------------------------
CHAT_RATE_LIMIT=20/minute # Maximum chat messages per IP on the chat endpoint.
  # Format: "<number>/<period>" (for example, "20/minute", "200/hour").
  # Raise or lower it based on the traffic you expect.

TRUST_PROXY_HEADERS=false # Set to true ONLY when the backend runs behind a trusted reverse proxy or load balancer.
  # When true, the client IP used for rate limiting is read from the X-Forwarded-For header.
  # Leave it false locally. Turning it on with no proxy in front lets a client forge the IP and skip the limit.

# ------------------------------------------------------------
# FRONTEND (CORS)
# ------------------------------------------------------------
FRONTEND_URL=* # In development, leave * to allow any origin.
  # In production, set the exact frontend URL (for example, https://app.example.com).

# ------------------------------------------------------------
# DEVELOPMENT
# ------------------------------------------------------------
ALLOW_DEV_COMPANY_FALLBACK=false # Local development only. Never set this in staging or production.
  # When true, requests without Authorization: Bearer use DEV_COMPANY_ID.
  # When missing or false, those requests receive 401.

DEV_COMPANY_ID=dev-company-id # UUID of the development company. Used only when ALLOW_DEV_COMPANY_FALLBACK=true.

# ------------------------------------------------------------
# SSO (shared with external website) + Frontline session
# ------------------------------------------------------------
SSO_SHARED_SECRET=change-me-sso-shared-secret-min-32-bytes
  # Same value on the external site. Signs the incoming JWT (URL parameter sso_token).
  # At least 32 characters. Do not commit the real value.

FRONTLINE_SESSION_SECRET=change-me-frontline-session-secret-min-32-bytes
  # Frontline-only secret (never shared with the site). Signs the internal session token (24h).
  # At least 32 characters.

# ------------------------------------------------------------
# UPSTASH REDIS (single-use SSO tokens)
# ------------------------------------------------------------
KV_REST_API_URL=
  # REST URL of Frontline's Upstash database. Without this value, SSO is rejected.

KV_REST_API_TOKEN=
  # Private token for the same Upstash database. Do not commit the real value.
  # Without this value, SSO is rejected.

# ------------------------------------------------------------
# AI / MACHINE LEARNING
# ------------------------------------------------------------
ANTHROPIC_API_KEY=your-anthropic-api-key

# ------------------------------------------------------------
# VOYAGE AI (EMBEDDINGS)
# ------------------------------------------------------------
VOYAGE_API_KEY=your-voyage-api-key

# ------------------------------------------------------------
# SUPABASE
# ------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_SCHEMA=frontline # Database schema that holds every Frontline table, function, and view.
  # Also add it in Supabase: Settings -> API -> Exposed schemas.
