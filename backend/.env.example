# ============================================================
# MDK FRONTLINE - ENVIRONMENT CONFIGURATION
# ============================================================

# ------------------------------------------------------------
# LOGGING
# ------------------------------------------------------------
LOG_LEVEL=INFO

# ------------------------------------------------------------
# RATE LIMITING
# ------------------------------------------------------------
CHAT_RATE_LIMIT=20/minute # Limite massimo di messaggi per IP al minuto sull'endpoint chat.
  # Formato: "<numero>/<periodo>" (es. "20/minute", "200/hour").
  # Aumenta o diminuisci in base al traffico atteso.

TRUST_PROXY_HEADERS=false # Metti a true SOLO se il backend gira dietro un reverse proxy / load balancer fidato.
  # Se true, l'IP del client per il rate limiting viene letto dall'header X-Forwarded-For.
  # Lasciare false in locale: attivarlo senza un proxy davanti permette di falsificare l'IP e aggirare il limite.

# ------------------------------------------------------------
# FRONTEND (CORS)
# ------------------------------------------------------------
FRONTEND_URL=* # In sviluppo lascia * per permettere qualsiasi origine.
  # In produzione imposta l'URL esatto del frontend (es. https://app.tuosito.com).

# ------------------------------------------------------------
# DEVELOPMENT
# ------------------------------------------------------------
DEV_COMPANY_ID=dev-company-id

# ------------------------------------------------------------
# SSO (shared with MDK-137 website) + Frontline session
# ------------------------------------------------------------
SSO_SHARED_SECRET=change-me-sso-shared-secret-min-32-bytes
  # Stesso valore sul sito MDK-137. Firma il JWT di ingresso (parametro URL sso_token).
  # Almeno 32 caratteri. Non committare il valore reale.

FRONTLINE_SESSION_SECRET=change-me-frontline-session-secret-min-32-bytes
  # Secret SOLO di Frontline (mai condiviso col sito). Firma il token di sessione interno (24h).
  # Almeno 32 caratteri.

# ------------------------------------------------------------
# UPSTASH REDIS (token SSO monouso)
# ------------------------------------------------------------
KV_REST_API_URL=
  # URL REST del database Upstash di Frontline. Senza questo valore l'SSO viene rifiutato.

KV_REST_API_TOKEN=
  # Token privato dello stesso database Upstash di Frontline. Non committare il valore reale.
  # Senza questo valore l'SSO viene rifiutato.

# ------------------------------------------------------------
# AI / MACHINE LEARNING
# ------------------------------------------------------------
ANTHROPIC_API_KEY=your-anthropic-api-key

# ------------------------------------------------------------
# VOYAGE AI (EMBEDDINGS)
# ------------------------------------------------------------
VOYAGE_API_KEY=your-voyage-api-key

# ------------------------------------------------------------
# SUPABASE
# ------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_SCHEMA=frontline # Schema del database in cui vivono tutte le tabelle/funzioni/view di Frontline.
  # Deve essere aggiunto anche in Supabase: Settings -> API -> Exposed schemas.
